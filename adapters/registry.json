{
  "version": "2026-05-18.1",
  "adapters": [
    {
      "language": "typescript",
      "extensions": [".ts", ".tsx"],
      "astGrep": { "languageId": "typescript", "supported": "builtin" },
      "lsp": {
        "commands": ["typescript-language-server --stdio"],
        "capabilities": ["definition", "references", "rename", "diagnostics", "symbols"]
      },
      "fallback": ["rg", "grep"],
      "fixtures": { "repo": "fixtures/repos/typescript-basic", "expectedAst": true, "expectedLsp": "optional" }
    },
    {
      "language": "javascript",
      "extensions": [".js", ".jsx", ".mjs", ".cjs"],
      "astGrep": { "languageId": "javascript", "supported": "builtin" },
      "lsp": {
        "commands": ["typescript-language-server --stdio"],
        "capabilities": ["definition", "references", "rename", "diagnostics", "symbols"]
      },
      "fallback": ["rg", "grep"],
      "fixtures": { "repo": "fixtures/repos/mixed-no-lsp", "expectedAst": true, "expectedLsp": "optional" }
    },
    {
      "language": "python",
      "extensions": [".py"],
      "astGrep": { "languageId": "python", "supported": "builtin" },
      "lsp": {
        "commands": ["pyright-langserver --stdio", "pylsp"],
        "capabilities": ["definition", "references", "rename", "diagnostics", "symbols"]
      },
      "fallback": ["rg", "grep"],
      "fixtures": { "repo": "fixtures/repos/python-basic", "expectedAst": true, "expectedLsp": "optional" }
    },
    {
      "language": "json",
      "extensions": [".json"],
      "astGrep": { "languageId": "json", "supported": "builtin" },
      "lsp": { "commands": [], "capabilities": [] },
      "fallback": ["rg", "grep"],
      "fixtures": { "repo": "fixtures/repos/mixed-no-lsp", "expectedAst": true, "expectedLsp": false }
    }
  ]
}
